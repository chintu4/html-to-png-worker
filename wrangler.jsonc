{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-to-png-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "MYBROWSER"
  },
  "observability": {
    "enabled": true
  }
}
